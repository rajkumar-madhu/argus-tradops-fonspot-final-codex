TRADEOPS_DEMO_MODE=true
# Local (non-Docker) host path. docker-compose overrides this to
# /data/journal/Journal.log and bind-mounts mirae-finspot-management-console-elk/Journal.log.
TRADEOPS_JOURNAL_PATH=../mirae-finspot-management-console-elk/Journal.log
# Optional L_ORDERLATENCY*.csv path; auto-discovered beside the journal if omitted.
TRADEOPS_ORDER_LATENCY_PATH=
# Set TRADEOPS_JOURNAL_PRIMARY=true to force journal data even when demo mode is off.
TRADEOPS_JOURNAL_PRIMARY=false
AUTH_DISABLED=true
ALLOW_SIGNUP=false
CORS_ORIGINS=http://localhost:3000

ELASTICSEARCH_URL=https://your-elk:9200
ELASTICSEARCH_API_KEY=replace-with-read-only-api-key
ELASTICSEARCH_VERIFY_CERTS=true
NOREN_ORDER_INDEX=noren-ordupd-intraday
NOREN_LOGIN_INDEX=noren-login-intraday
NOREN_LOGOUT_INDEX=noren-logout-intraday
NOREN_YEL_INDEX=noren-yel_connected-intraday
NOREN_ALL_INDEX=noren-*-intraday
NOREN_TIMESTAMP_FIELD=NorenTimeStamp_N
NOREN_PRICE_DIVISOR=100

REDIS_URL=redis://redis:6379/0
REDIS_PUBLIC_LABEL=redis
REDIS_STREAM_MAXLEN=100000
REDIS_CORRELATION_GROUP=tradeops-correlation
DATABASE_URL=postgresql+psycopg://tradeops:tradeops@postgres:5432/tradeops
COLLECTOR_INTERVAL_SECONDS=2
COLLECTOR_LOOKBACK=2h
COLLECTOR_ORDER_BATCH=250
COLLECTOR_REJECTION_SCAN_LIMIT=2500
RCA_LOOKBACK=30d
SSE_HEARTBEAT_SECONDS=15

KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=tradeops
KEYCLOAK_CLIENT_ID=tradeops-web
KEYCLOAK_VERIFY_AUDIENCE=true

# Production hardening
AUTO_CREATE_SCHEMA=false
METRICS_ENABLED=true
WORKER_METRICS_PORT=9108
COLLECTOR_LEADER_KEY=tradeops:leader:collector
COLLECTOR_LEADER_TTL_SECONDS=15
REDIS_DLQ_STREAM=tradeops:dlq
REDIS_RETRY_MAX_ATTEMPTS=5
REDIS_RETRY_IDLE_MS=30000
REDIS_RETRY_KEY_TTL=86400

# TrueData market data (optional — enable market_data_worker)
TRUEDATA_ENABLED=false
PROMETHEUS_URL=
# Optional Prometheus HTTP API endpoint used by /api/infra for node-exporter summaries.
PROMETHEUS_TIMEOUT_SECONDS=2
TRUEDATA_USERNAME=
TRUEDATA_PASSWORD=
TRUEDATA_SYMBOLS=RELIANCE-EQ,NIFTY-I,BANKNIFTY-I
# TRUEDATA_WS_URL=https://wstest.truedata.in
# TRUEDATA_WS_PORT=
MARKET_FLUSH_INTERVAL_SECONDS=1
MARKET_SNAPSHOT_TTL_SECONDS=120
MARKET_LEADER_KEY=tradeops:leader:market
MARKET_LEADER_TTL_SECONDS=15
REDIS_MARKET_STREAM=tradeops:market
